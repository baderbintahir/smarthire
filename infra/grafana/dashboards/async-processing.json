    },
    {
      "type": "timeseries",
      "title": "Outbox backlog",
      "description": "Committed events not yet on Kafka (the services that have an outbox)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "smarthire_outbox_backlog{service=~\"identity|job|candidate|application|scoring\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
