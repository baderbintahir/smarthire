    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Ready = waiting for a worker. Growing = workers stopped or too slow",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready{queue=~\"emails|resumes\"})",
          "legendFormat": "{{queue}} ready",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked{queue=~\"emails|resumes\"})",
          "legendFormat": "{{queue}} in progress",
