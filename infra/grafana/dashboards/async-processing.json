    {
      "type": "timeseries",
      "title": "Dead-lettered (1 h)",
      "description": "Any value > 0 needs a human: inspect <topic>.dlq in Kafka UI",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumer, topic) (increase(smarthire_dlq_messages_total[1h]))",
          "legendFormat": "{{consumer}} {{topic}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 8,
        "h": 8,
        "x": 16,
