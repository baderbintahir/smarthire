    },
    {
      "type": "timeseries",
      "title": "Oldest unpublished outbox event",
      "description": "Seconds. Above a few seconds: Kafka down or the relay stuck",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (smarthire_outbox_oldest_age_seconds{service=~\"identity|job|candidate|application|scoring\"})",
