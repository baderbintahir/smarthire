{
  "description": "The AI assistant answered a question (Phase 16). Usage data only, never the question text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "role",
    "intent",
    "tokens_in",
    "tokens_out",
    "latency_ms"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "RECRUITER",
        "ADMIN"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "user_id": "01a1b2c3-0000-7000-8000-000000000002",
      "role": "RECRUITER",
      "intent": "shortlist",
      "tokens_in": 1200,
      "tokens_out": 300,
      "latency_ms": 2400
    }
  ]
}
