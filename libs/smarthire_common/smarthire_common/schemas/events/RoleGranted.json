{
  "description": "A user gained a role (self-service or by an admin). Candidate creates a profile for CANDIDATE; Analytics counts role holders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "role",
    "granted_by"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "RECRUITER",
        "ADMIN"
      ]
    },
    "granted_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "null when self-granted"
    }
  },
  "examples": [
    {
      "user_id": "01a1b2c3-0000-7000-8000-000000000001",
      "role": "CANDIDATE",
      "granted_by": null
    }
  ]
}
